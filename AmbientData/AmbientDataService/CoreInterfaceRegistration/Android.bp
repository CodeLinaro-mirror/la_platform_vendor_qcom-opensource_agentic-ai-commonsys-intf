aidl_interface {
    name: "vendor.qti.sub",
    srcs: ["vendor/qti/sub/*.aidl"],
    imports: ["vendor.qti.coreif-V1"],
    system_ext_specific: true,
    vendor_available: true,
    stability: "vintf",
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            sdk_version: "module_current",
        },
        ndk: {
            enabled: true,
        },
    },
    frozen: true,
    versions_with_info: [
        {
            version: "1",
            imports: ["vendor.qti.coreif-V1"],
        },
    ],

}
